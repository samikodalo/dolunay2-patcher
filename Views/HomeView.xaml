<views:PageViewBase x:Class="Dolunay2Launcher.Views.HomeView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Dolunay2Launcher.Views"
                    xmlns:controls="clr-namespace:Dolunay2Launcher.Controls"
                    FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="HeroReadMoreButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="30,0,30,0" />
            <Setter Property="Foreground" Value="#FFF2E9D8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="#00FFFFFF" UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="59" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="59" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="frame" Grid.ColumnSpan="3" Opacity="0.85" RenderOptions.EdgeMode="Aliased">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="59" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="59" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="1" Source="/Resources/Images/Buttons/readmore_mid.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Column="0" Source="/Resources/Images/Buttons/readmore_left.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Grid.Column="2" Source="/Resources/Images/Buttons/readmore_right.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <ContentPresenter Grid.ColumnSpan="3" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="frame" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= HERO ================= -->
        <Grid ClipToBounds="True">
            <Rectangle x:Name="HeroImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill>
                    <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" AlignmentX="Right" RenderOptions.BitmapScalingMode="HighQuality" />
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{DynamicResource Theme.Page.F2.Color}" Offset="0" />
                        <GradientStop Color="{DynamicResource Theme.Page.B3.Color}" Offset="0.35" />
                        <GradientStop Color="{DynamicResource Theme.Page.00.Color}" Offset="0.7" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False" Height="160" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource Theme.Base.CC.Color}" Offset="0" />
                        <GradientStop Color="{DynamicResource Theme.Base.00.Color}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False" Height="460" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource Theme.Page.00.Color}" Offset="0" />
                        <GradientStop Color="{DynamicResource Theme.Page.C0.Color}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource Theme.Page.Color}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- hero metinleri -->
            <StackPanel Width="680" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,300">
                <Border x:Name="HeroBadge" HorizontalAlignment="Left" CornerRadius="12" Padding="14,4" Margin="0,0,0,10"
                        BorderBrush="#40CF9A2E" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF2D7FF9" Offset="0" />
                            <GradientStop Color="#FF1C56B8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="HeroBadgeIcon" Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.Megaphone}"
                              Width="13" Height="13" Fill="#FFFFFFFF" Margin="0,0,7,0" Visibility="Visible" />
                        <TextBlock x:Name="HeroChip" FontSize="13" Foreground="#FFFFFFFF" FontWeight="Bold"
                                   FontFamily="{StaticResource AppFont}" Text="DUYURU" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="HeroTitle" TextWrapping="Wrap" FontSize="44" Foreground="#FFFFFFFF" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}" LineHeight="50" LineStackingStrategy="BlockLineHeight" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="HeroTag" FontSize="17" Foreground="#FFC9AE7C" FontWeight="Bold"
                               FontFamily="{StaticResource AppFont}" Margin="0,0,14,0" Visibility="Collapsed" />
                    <TextBlock x:Name="HeroDate" FontSize="14" Foreground="#FFC9AE7C" FontWeight="Bold"
                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" />
                </StackPanel>
                <Rectangle Height="2" Width="64" HorizontalAlignment="Left" Fill="#FFC9AE7C" Margin="0,12,0,12" />
                <TextBlock x:Name="HeroDesc" TextWrapping="Wrap" FontSize="15" Foreground="#FFF2E9D8" FontFamily="{StaticResource AppFont}"
                           FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxHeight="72" MaxWidth="600" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="HeroReadBtn" Style="{StaticResource HeroReadMoreButton}" Click="HeroReadBtn_Click" ToolTip="Open external link">
                        <TextBlock x:Name="HeroReadText" Text="Devamını Oku" FontFamily="{StaticResource AppFont}" FontWeight="Bold"
                                   FontSize="15" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- slayt kontrolleri -->
            <StackPanel Orientation="Horizontal" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,266">
                <Button x:Name="SlidePauseBtn" Style="{DynamicResource NormalButtonStyle}" Width="20" Height="20" Margin="0,0,12,0"
                        Background="{x:Null}" Click="SlidePauseBtn_Click" ToolTip="Slaytı duraklat">
                    <Path x:Name="SlidePauseIcon" Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.Pause}"
                          Fill="#FFF2E9D8" Width="12" Height="12" />
                </Button>
                <StackPanel x:Name="SlideDots" Orientation="Horizontal" VerticalAlignment="Center" />
            </StackPanel>

            <!-- platform etiketleri + logo -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,260">
                <Border BorderBrush="#66C9AE7C" BorderThickness="1" CornerRadius="16" Padding="14,6" Background="#40000000">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.Windows}" Width="14" Height="14"
                              Fill="#FFE8D6AE" Margin="0,0,7,0" />
                        <TextBlock x:Name="CrossPlatformText" Text="PC PLATFORM" FontFamily="{StaticResource AppFont}" FontWeight="Bold"
                                   FontSize="12" Foreground="#FFF2E9D8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="#66C9AE7C" BorderThickness="1" CornerRadius="16" Padding="14,6" Background="#40000000" Margin="8,0,0,0">
                    <TextBlock x:Name="FreeText" Text="ÜCRETSİZ" FontFamily="{StaticResource AppFont}" FontWeight="Bold"
                               FontSize="12" Foreground="#FFF2E9D8" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= DUYURULAR ================= -->
        <Grid x:Name="NewsStrip" VerticalAlignment="Bottom" Height="236" Background="{DynamicResource Theme.Page}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="48,0,48,0">
                <DockPanel VerticalAlignment="Top" Margin="0,9,0,0" LastChildFill="False">
                    <Border DockPanel.Dock="Left" Width="4" Height="18" CornerRadius="2" Background="#FFC4343C" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="NewsSectionTitle" DockPanel.Dock="Left" Text="Duyurular" FontFamily="{StaticResource AppFont}"
                               FontWeight="Bold" FontSize="19" Foreground="#FFF2E9D8" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                                Background="#00FFFFFF" MouseLeftButtonUp="AllNewsBtn_Click">
                        <TextBlock x:Name="AllNewsText" Text="Tüm Duyurular" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource Theme.Muted}" VerticalAlignment="Center" />
                        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.ArrowRight}" Width="14" Height="14"
                              Fill="#FFE8D6AE" Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <UniformGrid x:Name="NewsItems" Grid.Row="1" Rows="1" Columns="4" Margin="48,0,32,6" ClipToBounds="True" />
        </Grid>
    </Grid>
</views:PageViewBase>
