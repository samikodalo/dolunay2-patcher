<views:PageViewBase x:Class="Dolunay2Launcher.Views.NewsView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Dolunay2Launcher.Views"
                    xmlns:controls="clr-namespace:Dolunay2Launcher.Controls"
                    FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ListFilters" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource BareListBox}"
                 ItemContainerStyle="{StaticResource FilterChipItem}" Margin="0,0,0,16" SelectionChanged="Filters_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox x:Name="ListAnnouncements" Grid.Row="1" Grid.Column="0" Style="{StaticResource BareListBox}"
                 ItemContainerStyle="{StaticResource CardListItem}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="Announcements_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="1,0,0,1" Background="{Binding CategoryBrush}" />
                        <StackPanel Grid.Column="1" Margin="16,14,16,14">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="8,3" Background="#26FFFFFF">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource VectorIcon}" Width="12" Height="12" Margin="0,0,6,0"
                                              Data="{Binding CategoryIcon}" Fill="{Binding CategoryBrush}" />
                                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding CategoryLabel}"
                                                   Foreground="{Binding CategoryBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Theme.Dim}"
                                           VerticalAlignment="Center" Text="{Binding DateText}" />
                            </DockPanel>
                            <TextBlock FontSize="17" FontWeight="Bold" Foreground="#FFF2E9D8" Margin="0,10,0,4"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource Theme.Dim}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="36" Text="{Binding Summary}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PageCard}" CornerRadius="0" BorderThickness="0" ClipToBounds="True"
                PreviewMouseWheel="DetailScroll_PreviewMouseWheel">
            <Grid>
                <TextBlock x:Name="DetailEmpty" Text="Okumak için bir duyuru seçin" FontSize="16"
                           Foreground="{DynamicResource Theme.Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid x:Name="DetailContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="0" ClipToBounds="True">
                        <Grid>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="DetailGradientStart" Color="#FF8A7450" Offset="0" />
                                        <GradientStop Color="{DynamicResource Theme.Panel.Color}" Offset="0.9" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="DetailImage" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="DetailImageBrush" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path x:Name="DetailBigIcon" Style="{StaticResource VectorIcon}" Width="180" Height="180"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Fill="#1FFFFFFF" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource Theme.Panel.00.Color}" Offset="0.3" />
                                        <GradientStop Color="{DynamicResource Theme.Panel.Color}" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,8">
                                <Border HorizontalAlignment="Left" CornerRadius="4" Padding="10,4" Background="{DynamicResource Theme.Base.99}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="DetailCategoryIcon" Style="{StaticResource VectorIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                                        <TextBlock x:Name="DetailCategory" Style="{StaticResource BadgeText}" FontSize="12" Text="GÜNCELLEME" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="DetailTitle" Text="Başlık" FontSize="30" FontWeight="Bold" Foreground="#FFFFFFFF"
                                           TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="32,8,16,24"
                                  PreviewMouseWheel="DetailScroll_PreviewMouseWheel">
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.Clock}" Width="14" Height="14"
                                      Fill="{DynamicResource Theme.Dim}" Margin="0,0,6,0" />
                                <TextBlock x:Name="DetailDate" Text="01 Ekim 2026" FontSize="13"
                                           Foreground="{DynamicResource Theme.Dim}" VerticalAlignment="Center" />
                            </StackPanel>
                            <FlowDocumentScrollViewer x:Name="DetailDoc" VerticalScrollBarVisibility="Disabled"
                                                      HorizontalScrollBarVisibility="Disabled" Background="Transparent" />
                            <Button x:Name="DetailForum" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                                    Margin="0,20,0,0" Click="DetailForum_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.OpenInNew}" Width="14" Height="14"
                                          Fill="#FFE8D6AE" Margin="0,0,8,0" />
                                    <TextBlock x:Name="DetailForumText" Text="Forumda oku" FontSize="14" FontWeight="Bold"
                                               Foreground="#FFF2E9D8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <controls:OrnamentFrame x:Name="DetailFrame" />
            </Grid>
        </Border>
    </Grid>
</views:PageViewBase>
