<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
  <Color x:Key="GoldColor">#C9AE7C</Color>
  <Color x:Key="GoldLightColor">#E8D6AE</Color>
  <Color x:Key="GoldDarkColor">#8A7450</Color>
  <Color x:Key="BackgroundColor">#0E0C0A</Color>
  <Color x:Key="CrimsonColor">#C4343C</Color>
  <Color x:Key="CrimsonLightColor">#E04B52</Color>
  <Color x:Key="CrimsonDarkColor">#6E171C</Color>
  <SolidColorBrush x:Key="goldBrush" Color="#C9AE7C" />
  <SolidColorBrush x:Key="goldLightBrush" Color="#E8D6AE" />
  <SolidColorBrush x:Key="goldDarkBrush" Color="#8A7450" />
  <SolidColorBrush x:Key="backgroundBrush" Color="#0E0C0A" />
  <SolidColorBrush x:Key="panelDarkBrush" Color="#15120F" />
  <SolidColorBrush x:Key="crimsonBrush" Color="#C4343C" />
  <SolidColorBrush x:Key="crimsonLightBrush" Color="#E04B52" />
  <SolidColorBrush x:Key="lineBrush" Color="#2A241C" />
  <ImageBrush x:Key="PlayButtonReadyBrush" ImageSource="pack://application:,,,/Resources/Images/Buttons/button_0.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
  <ImageBrush x:Key="PlayButtonHoverBrush" ImageSource="pack://application:,,,/Resources/Images/Buttons/button_4.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
  <LinearGradientBrush x:Key="PlayButtonReadyBrush_Gold" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFF4E8CF" Offset="0" />
    <GradientStop Color="#FFD9C292" Offset="0.55" />
    <GradientStop Color="#FFB89C68" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PlayButtonReadyForeground" Color="#FF1A140C" />
  <ImageBrush x:Key="PlayButtonErrorBrush" ImageSource="pack://application:,,,/Resources/Images/Buttons/buton_red_0.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
  <ImageBrush x:Key="PlayButtonErrorHoverBrush" ImageSource="pack://application:,,,/Resources/Images/Buttons/buton_red_1.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
  <LinearGradientBrush x:Key="PlayButtonErrorBrush_Gradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFD8434A" Offset="0" />
    <GradientStop Color="#FF9E2229" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PlayButtonErrorForeground" Color="#FFFFFFFF" />
  <ImageBrush x:Key="PlayButtonBusyBrush" ImageSource="pack://application:,,,/Resources/Images/Buttons/button_3.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
  <SolidColorBrush x:Key="PlayButtonBusyForeground" Color="#FF1A140C" />
  <SolidColorBrush x:Key="color1" Color="Black" />
  <SolidColorBrush x:Key="color2" Color="White" />
  <SolidColorBrush x:Key="color3" Color="Gray" />
  <SolidColorBrush x:Key="color4" Color="#FB539B" />
  <SolidColorBrush x:Key="color5" Color="#7E82FC" />
  <SolidColorBrush x:Key="color6" Color="#FFC047" />
  <SolidColorBrush x:Key="color7" Color="#EF6C96" />
  <SolidColorBrush x:Key="color8" Color="#78A3FC" />
  <SolidColorBrush x:Key="color9" Color="#07F3C0" />
  <SolidColorBrush x:Key="color10" Color="#FBA1AA" />
  <SolidColorBrush x:Key="titleColor1" Color="#F2E9D8" />
  <SolidColorBrush x:Key="titleColor2" Color="#E8D6AE" />
  <SolidColorBrush x:Key="titleColor3" Color="#A89B82" />
  <SolidColorBrush x:Key="plainTextColor1" Color="#FFFFFF" />
  <SolidColorBrush x:Key="plainTextColor2" Color="#D8D8D8" />
  <SolidColorBrush x:Key="plainTextColor3" Color="#CCCCCC" />
  <SolidColorBrush x:Key="panelColor" Color="#FF1D1915" />
  <SolidColorBrush x:Key="panelOverColor" Color="#27221C" />
  <SolidColorBrush x:Key="panelActiveColor" Color="#FF1D1915" />
  <SolidColorBrush x:Key="buttonColor1" Color="#1D1915" />
  <SolidColorBrush x:Key="buttonColor2" Color="#0E0C0A" />
  <SolidColorBrush x:Key="buttonHighlightColor1" Color="#FF8A7450" />
  <Style x:Key="MainNavigationTextStyle" TargetType="{x:Type TextBlock}">
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="False">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Trigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="#E8D6AE" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>