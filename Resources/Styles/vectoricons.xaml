  <Style x:Key="PillTabStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border Name="pill" Background="{DynamicResource Theme.Gradient.Tab}" BorderBrush="{DynamicResource Theme.Line}" BorderThickness="1" CornerRadius="20" />
            <Border Name="hl" Background="{DynamicResource Theme.Tint.14}" BorderBrush="#66C9AE7C" BorderThickness="1" CornerRadius="20" Opacity="0" />
            <ContentPresenter Margin="22,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="#FFE8D6AE" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground" Value="#FFF2E9D8" />
              <Setter TargetName="pill" Value="{DynamicResource Theme.Gradient.TabActive}" Property="Border.Background" />
              <Setter TargetName="pill" Property="Border.BorderBrush" Value="#80C9AE7C" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="#FFF2E9D8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="bd" Height="34" CornerRadius="4" Padding="12,0,10,0" Background="#00FFFFFF">
            <DockPanel>
              <Path Name="check" DockPanel.Dock="Right" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 L9,16.17" Width="14" Height="14" Margin="12,0,0,0" Fill="#FFE8D6AE" Visibility="Hidden" Style="{StaticResource VectorIcon}" />
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="bd" Value="{DynamicResource Theme.Selected}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter Property="Foreground" Value="#FFE8D6AE" />
              <Setter TargetName="check" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconComboBoxStyle" TargetType="{x:Type ComboBox}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="36" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource IconComboBoxItemStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="ToggleButton" ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="plate" CornerRadius="5" Background="{DynamicResource Theme.Button}">
                    <Path Width="20" Height="20" Fill="#FFF2E9D8" Style="{StaticResource VectorIcon}" Data="{StaticResource Icon.Environment}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="plate" Property="Border.Background" Value="#FF8A7450" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter TargetName="plate" Property="Border.Background" Value="#FF8A7450" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <Popup Name="PART_Popup" Placement="Top" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border MinWidth="160" CornerRadius="6" Background="{DynamicResource Theme.Control.F2}" BorderBrush="#40C9AE7C" BorderThickness="1" Padding="4">
                <StackPanel>
                  <TextBlock Text="{TemplateBinding FrameworkElement.Tag}" Foreground="{DynamicResource Theme.Muted}" FontSize="11" FontWeight="Bold" Margin="12,6,12,4" FontFamily="{StaticResource AppFont}" />
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ToolTip.HasDropShadow" Value="False" />
    <Setter Property="Foreground" Value="#FF1A1612" />
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Grid Margin="8">
            <Border CornerRadius="10" Background="#FFF6F2EA" Margin="0,2,0,0">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
              </UIElement.Effect>
            </Border>
            <Border CornerRadius="10" Background="#FFF6F2EA" Padding="13,7,13,8">
              <ContentPresenter />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
