<UserControl x:Class="Dolunay2Launcher.Controls.SubNewsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Card" Cursor="Hand" Background="#00FFFFFF" Visibility="Visible">
        <Border x:Name="Shadow" CornerRadius="3" Background="{DynamicResource Theme.Panel}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect x:Name="ShadowFx" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.55" />
            </Border.Effect>
        </Border>
        <Rectangle x:Name="CardBackground" RadiusX="3" RadiusY="3" Fill="{DynamicResource Theme.Panel}" />
        <Grid x:Name="Fallback" Visibility="Collapsed" ClipToBounds="True">
            <Rectangle RadiusX="3" RadiusY="3">
                <Shape.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="Fallback_Color" Color="#FF8A7450" Offset="0" />
                        <GradientStop Color="{DynamicResource Theme.Panel.Color}" Offset="0.85" />
                    </LinearGradientBrush>
                </Shape.Fill>
            </Rectangle>
            <Path x:Name="Fallback_Icon" Style="{StaticResource VectorIcon}" Width="96" Height="96" Fill="#26FFFFFF"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" />
        </Grid>
        <Grid x:Name="ImageContainer">
            <Rectangle x:Name="ImageRect" RadiusX="3" RadiusY="3" RenderOptions.BitmapScalingMode="HighQuality">
                <Shape.Fill>
                    <ImageBrush x:Name="Image" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Shape.Fill>
            </Rectangle>
            <Rectangle x:Name="ImageTopShade" Height="16" VerticalAlignment="Top" RadiusX="3" RadiusY="3" IsHitTestVisible="False">
                <Shape.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#73000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Shape.Fill>
            </Rectangle>
        </Grid>
        <Grid x:Name="TextContainer" Visibility="Visible" IsHitTestVisible="False">
            <Rectangle x:Name="Content_Background" RadiusX="3" RadiusY="3">
                <Shape.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource Theme.Page.00.Color}" Offset="0.45" />
                        <GradientStop Color="{DynamicResource Theme.Page.C7.Color}" Offset="0.78" />
                        <GradientStop Color="{DynamicResource Theme.Page.F0.Color}" Offset="1" />
                    </LinearGradientBrush>
                </Shape.Fill>
            </Rectangle>
            <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                    CornerRadius="10" Padding="9,3" Background="{DynamicResource Theme.Base.E6}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="Badge_Icon" Style="{StaticResource VectorIcon}" Width="11" Height="11" Margin="0,0,5,0" />
                    <TextBlock x:Name="Badge_Text" Text="DUYURU" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,44">
                <TextBlock x:Name="Content_Date" TextWrapping="NoWrap" FontSize="11" Foreground="#FFC9BFA8"
                           FontFamily="{StaticResource AppFont}" FontWeight="Bold" Margin="0,0,0,2" />
                <TextBlock x:Name="Content_Title" TextWrapping="NoWrap" FontSize="16" Foreground="#FFFFFFFF"
                           FontFamily="{StaticResource AppFont}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Content_Text" TextWrapping="Wrap" FontSize="12" Foreground="#FFE6E0D4"
                           FontFamily="{StaticResource AppFont}" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
        <Border x:Name="HoverFrame" CornerRadius="3" BorderThickness="1" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#80C9AE7C" />
                    <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsMouseOver, ElementName=Card}">
                            <Setter Property="BorderBrush" Value="#FFC9AE7C" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>





