<UserControl x:Class="Dolunay2Launcher.Controls.SidebarServerIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:Dolunay2Launcher.Controls"
             Height="68" Cursor="Hand" Background="#00FFFFFF"
             ToolTipService.Placement="Right" ToolTipService.HorizontalOffset="2" ToolTipService.VerticalOffset="9"
             MouseEnter="ServerIcon_MouseEnter" MouseLeave="ServerIcon_MouseLeave"
             PreviewMouseLeftButtonDown="ServerIcon_Click">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="RowHighlight" Grid.ColumnSpan="2" Margin="0" CornerRadius="0" Background="#00FFFFFF" />
        <Border x:Name="Indicator" Grid.ColumnSpan="2" Width="3" Height="0" CornerRadius="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE04B52" Offset="0" />
                    <GradientStop Color="#FFC4343C" Offset="0.5" />
                    <GradientStop Color="#FF8E2027" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid x:Name="FrameHost" Width="52" Height="52">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="FrameLift" Y="0" />
            </Grid.RenderTransform>
            <Border x:Name="Frame" CornerRadius="7" BorderThickness="0" Background="#00FFFFFF">
                <Grid>
                    <Border x:Name="IconImage" CornerRadius="7" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="Image_Server" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <Border x:Name="Emboss" CornerRadius="7" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.4" />
                                <GradientStop Color="#00000000" Offset="0.6" />
                                <GradientStop Color="#59000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
            <uc:ClippingBorder x:Name="Shine" CornerRadius="7" IsHitTestVisible="False">
                <Canvas>
                    <Rectangle x:Name="ShineBar" Width="20" Height="96" Canvas.Left="16" Canvas.Top="-22">
                        <Shape.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFF4DC" Offset="0" />
                                <GradientStop Color="#80FFF4DC" Offset="0.5" />
                                <GradientStop Color="#00FFF4DC" Offset="1" />
                            </LinearGradientBrush>
                        </Shape.Fill>
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="22" CenterX="10" CenterY="48" />
                                <TranslateTransform x:Name="ShineMove" X="-64" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </uc:ClippingBorder>
            <Border x:Name="PlatformBadge" Width="24" Height="24" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,-6,-6" BorderThickness="1" BorderBrush="{DynamicResource Theme.Control.92}" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFE04B52" Offset="0" />
                        <GradientStop Color="#FFC4343C" Offset="0.5" />
                        <GradientStop Color="#FF8E2027" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Path x:Name="PlatformBadge_Icon" Fill="#FFFFF6EA" Stretch="Uniform" Width="14" Height="14"
                      HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
            </Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock x:Name="Server_Title" Text="Server" FontFamily="{StaticResource AppFont}" FontWeight="Bold"
                       FontSize="16" Foreground="#FFF2E9D8" TextTrimming="CharacterEllipsis" />
            <ContentControl x:Name="Server_Platforms" Margin="0,5,0,0" IsTabStop="False" />
        </StackPanel>
    </Grid>
</UserControl>
