<UserControl x:Class="Dolunay2Launcher.Controls.SidebarNavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="65" Cursor="Hand" Background="#00FFFFFF"
             ToolTipService.Placement="Right" ToolTipService.HorizontalOffset="2" ToolTipService.VerticalOffset="7"
             MouseEnter="NavItem_MouseEnter" MouseLeave="NavItem_MouseLeave"
             PreviewMouseLeftButtonDown="NavItem_Click">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="RowHighlight" Grid.ColumnSpan="2" Margin="0" Background="#00FFFFFF" />
        <Border x:Name="Indicator" Width="4" Height="0" CornerRadius="0,3,3,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FFC4343C">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#FFC4343C" Opacity="0.7" />
            </Border.Effect>
        </Border>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="Highlight" Width="48" Height="48" CornerRadius="12" Background="#00FFFFFF">
                <Grid>
                    <Path x:Name="IconPath" Style="{StaticResource VectorIcon}" Width="20" Height="20" Fill="#FFD4B57A"
                          RenderTransformOrigin="0.5,0.5" Data="{Binding IconData, ElementName=Root}">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="IconRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <Border x:Name="Badge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,3,1,0" MinWidth="18" Height="18" CornerRadius="9" Padding="4,0"
                            Background="#FFC4343C" BorderBrush="#FF0E0C0A" BorderThickness="1.5">
                        <TextBlock x:Name="BadgeText" FontFamily="{StaticResource AppFont}" FontSize="10" FontWeight="Bold"
                                   Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                </Grid>
            </Border>
            <TextBlock x:Name="Caption" FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="Bold"
                       Foreground="#FFE2D5BB" HorizontalAlignment="Center" Margin="0,2,0,0"
                       Text="{Binding Label, ElementName=Root}" />
        </StackPanel>
        <TextBlock x:Name="SideLabel" Grid.Column="1" FontFamily="{StaticResource AppFont}" FontSize="18"
                   FontWeight="SemiBold" Foreground="#FFE2D5BB" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" Visibility="Collapsed"
                   Text="{Binding Label, ElementName=Root}" />
    </Grid>
</UserControl>
