<Application x:Class="Dolunay2Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/uicolors.xaml" />
                <ResourceDictionary Source="Resources/Styles/vectoricons.xaml" />
                <ResourceDictionary Source="Resources/Styles/buttonstyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/comboboxstyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/pagestyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/iconsstyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- renkler -->
        <Color x:Key="CBg">#FF0A0A0C</Color>
        <Color x:Key="CSidebar">#E60C0C0E</Color>
        <Color x:Key="CCard">#E6141417</Color>
        <Color x:Key="CRed">#FFE23B3B</Color>
        <Color x:Key="CGold">#FFD4A63A</Color>
        <Color x:Key="CGreen">#FF4CAF50</Color>
        <Color x:Key="CText">#FFF5F5F5</Color>
        <Color x:Key="CMuted">#FF9A9AA2</Color>

        <SolidColorBrush x:Key="BBg" Color="{StaticResource CBg}" />
        <SolidColorBrush x:Key="BSidebar" Color="{StaticResource CSidebar}" />
        <SolidColorBrush x:Key="BCard" Color="{StaticResource CCard}" />
        <SolidColorBrush x:Key="BRed" Color="{StaticResource CRed}" />
        <SolidColorBrush x:Key="BGold" Color="{StaticResource CGold}" />
        <SolidColorBrush x:Key="BGreen" Color="{StaticResource CGreen}" />
        <SolidColorBrush x:Key="BText" Color="{StaticResource CText}" />
        <SolidColorBrush x:Key="BMuted" Color="{StaticResource CMuted}" />
        <SolidColorBrush x:Key="BLine" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="BAccentBg" Color="#1FE23B3B" />

